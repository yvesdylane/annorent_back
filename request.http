@baseUrl = http://localhost:3000
@email = john@example.com
@password = password123

### GET /hello
GET {{baseUrl}}/hello
Accept: application/json

> {%
  client.test("Request executed successfully", function () {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(response.body.message === "Hello World!", "Unexpected message");
  });
%}

### POST /auth/register
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "John Doe",
  "email": "{{email}}",
  "password": "{{password}}",
  "phoneNumber": null
}

> {%
  client.test("User registered", function () {
    client.assert(response.status === 201 || response.status === 200, "Expected 2xx response");
    client.assert(!!response.body.accessToken, "Missing accessToken");
    client.assert(!!response.body.refreshToken, "Missing refreshToken");
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### POST /auth/login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
  client.test("User logged in", function () {
    client.assert(response.status === 200 || response.status === 201, "Expected 2xx response");
    client.assert(!!response.body.accessToken, "Missing accessToken");
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### POST /auth/refresh
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  client.test("Tokens refreshed", function () {
    client.assert(response.status === 200 || response.status === 201, "Expected 2xx response");
    client.assert(!!response.body.accessToken, "Missing accessToken");
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### GET /auth/me
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
  client.test("Current user returned", function () {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(!!response.body.userId, "Missing userId");
  });
%}

