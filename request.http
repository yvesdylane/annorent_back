POST /auth/register
Headers: none
Body: {"name":"John Doe","email":"john@example.com","password":"password123","phoneNumber":null}
200
{"user":{"userId":"...","name":"John Doe","email":"john@example.com","role":"tenant","kycStatus":"pending",...},"accessToken":"...","refreshToken":"..."}

POST /auth/login
Headers: none
Body: {"email":"john@example.com","password":"password123"}
200 same shape

POST /auth/refresh
Headers: none
Body: {"refreshToken":"..."}
200 {"accessToken":"...","refreshToken":"..."}

GET /auth/me
Headers: Authorization: Bearer <accessToken>
200 PublicUser
