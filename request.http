@baseUrl = http://localhost:3000
#@email = john@example.com
#@password = password123
@email = admin@example.com
@password = 1234qwer

### GET /hello
GET {{baseUrl}}/hello
Accept: application/json

> {%
  client.test("Request executed successfully", function () {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(response.body.message === "Hello World!", "Unexpected message");
  });
%}

### POST /auth/register
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json
Accept: application/json

{
  "name": "John Doe",
  "email": "{{email}}",
  "password": "{{password}}",
  "phoneNumber": null
}

> {%
  client.test("User registered", function () {
    client.assert(response.status === 201 || response.status === 200, "Expected 2xx response");
    client.assert(!!response.body.accessToken, "Missing accessToken");
    client.assert(!!response.body.refreshToken, "Missing refreshToken");
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### POST /auth/login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
  client.test("User logged in", function () {
    client.assert(response.status === 200 || response.status === 201, "Expected 2xx response");
    client.assert(!!response.body.accessToken, "Missing accessToken");
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### POST /auth/refresh
# @name refresh
POST {{baseUrl}}/auth/refresh
Content-Type: application/json
Accept: application/json

{
  "refreshToken": "{{refreshToken}}"
}

> {%
  client.test("Tokens refreshed", function () {
    client.assert(response.status === 200 || response.status === 201, "Expected 2xx response");
    client.assert(!!response.body.accessToken, "Missing accessToken");
  });
  client.global.set("accessToken", response.body.accessToken);
  client.global.set("refreshToken", response.body.refreshToken);
%}

### GET /auth/me
GET {{baseUrl}}/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json

> {%
  client.test("Current user returned", function () {
    client.assert(response.status === 200, "Expected 200 OK");
    client.assert(!!response.body.userId, "Missing userId");
  });
%}

### GET /auth/google
GET {{baseUrl}}/auth/google

### POST /auth/admin/login (using env vars)
# @name adminLogin
POST {{baseUrl}}/auth/admin/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin@example.com",
  "password": "change-this-password"
}

> {%
  client.test("Admin logged in", function () {
    client.assert(response.status === 200 || response.status === 201, "Expected 2xx response");
    client.assert(!!response.body.accessToken, "Missing accessToken");
  });
  client.global.set("adminAccessToken", response.body.accessToken);
%}

### GET /admin/kyc?status=pending (validate pending owner KYC)
GET {{baseUrl}}/admin/kyc?status=pending
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### POST /admin/kyc/:id/approve
POST {{baseUrl}}/admin/kyc/{{kycSubmissionId}}/approve
Authorization: Bearer {{adminAccessToken}}
Accept: application/json

### POST /admin/kyc/:id/reject
POST {{baseUrl}}/admin/kyc/{{kycSubmissionId}}/reject
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json
Accept: application/json

{
  "rejectionReason": "Invalid document"
}
